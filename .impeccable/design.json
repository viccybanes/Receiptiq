    {
      "name": "Line item card",
      "kind": "custom",
      "description": "A ruled line card with a saved Item number and responsive expense fields.",
      "html": "<fieldset class=\"ds-item\"><legend>Line 1 · Item 41</legend><label class=\"ds-description\"><span>Description</span><input value=\"Coffee\" /></label><label><span>Quantity</span><input value=\"2\" /></label><label><span>Unit</span><input value=\"bag\" /></label><label><span>Unit price</span><input value=\"40.005\" /></label><label><span>Amount</span><input value=\"80.01\" /></label><label><span>Type</span><input value=\"Materials\" /></label></fieldset>",
      "css": ".ds-item{font-family:\"Segoe UI\",system-ui,sans-serif;position:relative;padding:14px 12px;margin:0 0 12px;border:1px solid var(--line,#dfe5de);border-radius:7px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;min-width:0;color:var(--ink,#22342b);background:var(--paper,#fff)}.ds-item legend{color:var(--muted,#637168);font-size:11px;padding:0 6px}.ds-item label{display:flex;flex-direction:column;gap:5px;min-width:0}.ds-item label>span{font-size:11px;font-weight:600}.ds-description{grid-column:1/-1}.ds-item input{box-sizing:border-box;width:100%;min-width:0;min-height:32px;padding:6px 8px;border:1px solid var(--line-strong,#c7d0c7);border-radius:5px;font-family:inherit;font-size:12px;line-height:1.5;color:inherit;background:var(--paper,#fff);font-variant-numeric:tabular-nums;caret-color:var(--green,#27634c)}.ds-item input:focus{border-color:var(--green,#27634c)}.ds-item input:focus-visible{outline:2px solid var(--green,#27634c);outline-offset:3px}@media(max-width:1150px){.ds-item{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.ds-item{grid-template-columns:repeat(2,minmax(0,1fr))}}"
