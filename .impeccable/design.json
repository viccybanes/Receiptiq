      "html": "<label class=\"ds-field\"><span>Receipt number</span><input placeholder=\"Vendor reference — leave blank if none\" aria-label=\"Receipt number\" /></label>",
      "css": ".ds-field{font-family:\"Segoe UI\",system-ui,sans-serif;display:flex;flex-direction:column;gap:6px;color:var(--ink,#22342b)}.ds-field>span{font-size:11px;font-weight:600}.ds-field input{font-family:\"Segoe UI\",system-ui,sans-serif;min-width:0;min-height:37px;padding:8px 10px;background:var(--paper,#fff);color:var(--ink,#22342b);border:1px solid var(--line-strong,#c7d0c7);border-radius:5px;font-size:12px;line-height:1.5;font-variant-numeric:tabular-nums;caret-color:var(--green,#27634c)}.ds-field input::placeholder{color:var(--muted,#637168);opacity:1}.ds-field input:focus{border-color:var(--green,#27634c)}.ds-field input:focus-visible{outline:2px solid var(--green,#27634c);outline-offset:3px;}",
