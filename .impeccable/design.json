    {
      "name": "Workspace panel",
      "kind": "card",
      "description": "A flat, ruled receipt-details container within the connected workspace.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-title\"><h2>Receipt details</h2><span>Saved locally</span></div><div class=\"ds-panel-body\"><strong>Ready for your review</strong><p>Compare each field with the receipt. Select a field to see its source.</p></div></section>",
      "css": ".ds-panel{font-family:\"Segoe UI\",system-ui,sans-serif;background:var(--paper,#fff);color:var(--ink,#22342b);border:1px solid var(--line,#dfe5de)}.ds-panel-title{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:58px;padding:14px 18px;border-bottom:1px solid var(--line,#dfe5de)}.ds-panel-title h2{margin:0;font-size:14px;font-weight:600}.ds-panel-title>span{font-size:10px;color:var(--muted,#637168)}.ds-panel-body{padding:20px 22px}.ds-panel-body strong{font-size:13px;font-weight:600;color:#765319}.ds-panel-body p{margin:6px 0 0;color:var(--muted,#637168);font-size:12px;line-height:1.5;max-width:60ch}",
