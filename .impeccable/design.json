      "description": "Primary upload, verification, and export actions.",
      "html": "<button class=\"ds-primary\">Verify receipt</button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:7px 12px;border:1px solid var(--line,#dfe5de);border-radius:6px;background:var(--paper,#fff);color:var(--ink,#22342b);font-size:14px;font-weight:600;line-height:1.3;cursor:pointer;background:var(--green,#27634c);color:var(--paper,#fff);border-color:var(--green,#27634c)}.ds-primary:hover:not(:disabled){background:var(--green-deep,#1b4c39);border-color:var(--green-deep,#1b4c39)}.ds-primary:focus-visible{outline:2px solid var(--green,#27634c);outline-offset:3px;}.ds-primary:disabled{opacity:.48;cursor:not-allowed}",
