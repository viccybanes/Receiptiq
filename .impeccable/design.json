    {
      "name": "Receipt queue row",
      "kind": "nav",
      "description": "A selected row in the receipt register, with source filename and written review status.",
      "html": "<nav class=\"ds-queue\" aria-label=\"Receipts\"><div class=\"ds-row\"><span class=\"ds-index\">01</span><button class=\"ds-receipt\" aria-current=\"true\"><strong>Northside Market</strong><span class=\"ds-file\">002-synthetic-cursive.png</span><span class=\"ds-status\"><span class=\"ds-dot\"></span>Needs review</span></button><svg class=\"ds-chevron\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></div></nav>",
      "css": ".ds-queue{font-family:\"Segoe UI\",system-ui,sans-serif;max-width:280px;color:var(--ink,#22342b)}.ds-row{display:flex;align-items:flex-start;gap:10px;padding:15px 12px 15px 15px;background:var(--green-wash,#eef5ef);border-bottom:1px solid var(--line-soft,#edf0eb);box-shadow:inset 0 0 0 1px #bed4c6}.ds-row:hover{background:var(--wash,#f3f6f2)}.ds-index{font-size:11px;color:var(--muted,#637168);font-variant-numeric:tabular-nums;padding-top:4px;width:18px}.ds-receipt{font-family:\"Segoe UI\",system-ui,sans-serif;display:flex;flex:1;min-width:0;flex-direction:column;align-items:flex-start;gap:4px;padding:0;background:transparent;border:0;text-align:left;color:var(--ink,#22342b);cursor:pointer}.ds-receipt strong{font-size:12px;font-weight:600}.ds-file{font-size:11px;color:var(--muted,#637168);max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-status{display:inline-flex;align-items:center;gap:5px;font-size:10px;margin-top:3px;color:#8b5d19}.ds-dot{width:5px;height:5px;border-radius:100%;background:currentColor}.ds-chevron{flex-shrink:0;color:var(--muted,#637168);margin-top:5px}.ds-receipt:focus-visible{outline:2px solid var(--green,#27634c);outline-offset:3px;}"
